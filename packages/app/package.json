{
  "name": "@shennian/app",
  "version": "0.5.1",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "preandroid": "pnpm build:webview",
    "android": "expo run:android",
    "preios": "sh scripts/sync-ios-icons.sh && node plugins/with-brand-icons.js && pnpm build:webview",
    "ios": "expo run:ios",
    "web": "env -u CI expo start --web",
    "web:clear": "env -u CI expo start --web --clear",
    "web:dev": "pnpm web",
    "web:dev:clear": "pnpm web:clear",
    "web:serve": "env -u CI BROWSER=none expo start --web",
    "web:serve:clear": "env -u CI BROWSER=none expo start --web --clear",
    "web:desktop": "env -u CI BROWSER=none SHENNIAN_DESKTOP_BUILD=1 EXPO_PUBLIC_SHENNIAN_CONTROL_SURFACE=desktop expo start --web --port 8082",
    "web:desktop:clear": "env -u CI BROWSER=none SHENNIAN_DESKTOP_BUILD=1 EXPO_PUBLIC_SHENNIAN_CONTROL_SURFACE=desktop expo start --web --port 8082 --clear",
    "typecheck": "tsc --noEmit",
    "build:webview": "tsx src/components/chat/webview/build.ts",
    "build:web": "bash ../../scripts/build-web-export.sh"
  },
  "dependencies": {
    "@expo/config-plugins": "^55.0.8",
    "@expo/dom-webview": "^55.0.6",
    "@expo/log-box": "^55.0.13",
    "@expo/metro-runtime": "~55.0.12",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.15.8",
    "@react-navigation/core": "^7.17.1",
    "@react-navigation/native": "^7.2.1",
    "@react-navigation/native-stack": "^7.14.9",
    "@react-navigation/routers": "^7.5.3",
    "@react-navigation/stack": "7.8.4",
    "@shennian/shared": "workspace:^",
    "@shennian/wire": "workspace:^",
    "expo": "~55.0.29",
    "expo-apple-authentication": "~55.0.16",
    "expo-application": "~55.0.19",
    "expo-asset": "55.0.19",
    "expo-audio": "~55.0.17",
    "expo-auth-session": "~55.0.18",
    "expo-camera": "~55.0.22",
    "expo-clipboard": "~55.0.16",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.18",
    "expo-document-picker": "~55.0.16",
    "expo-document-saver": "workspace:*",
    "expo-file-system": "~55.0.25",
    "expo-font": "~55.0.8",
    "expo-glass-effect": "55.0.11",
    "expo-image-manipulator": "~55.0.20",
    "expo-image-picker": "~55.0.23",
    "expo-linking": "~55.0.17",
    "expo-localization": "~55.0.18",
    "expo-location": "~55.1.13",
    "expo-media-library": "~55.0.20",
    "expo-modules-core": "~55.0.25",
    "expo-notifications": "~55.0.26",
    "expo-pcm-recorder": "workspace:*",
    "expo-router": "~55.0.18",
    "expo-speech": "~55.0.17",
    "expo-sqlite": "~55.0.19",
    "expo-status-bar": "~55.0.6",
    "expo-task-manager": "~55.0.19",
    "expo-updates": "~55.0.27",
    "expo-web-browser": "~55.0.19",
    "highlight.js": "^11.11.1",
    "i18next": "^25.10.10",
    "jcore-react-native": "^2.3.5",
    "jpush-react-native": "^3.2.6",
    "katex": "^0.18.4",
    "marked": "^15.0.0",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^16.6.6",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-markdown-display": "^7.0.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "shiki": "^4.0.2",
    "vditor": "^3.11.2",
