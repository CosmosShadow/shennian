{
  "name": "@shennian/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/lib/api.d.ts",
      "import": "./dist/lib/api.js"
    },
    "./auth": {
      "types": "./dist/stores/auth.d.ts",
      "import": "./dist/stores/auth.js"
    },
    "./chat": {
      "types": "./dist/stores/chat.d.ts",
      "import": "./dist/stores/chat.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./agent-participation": {
      "types": "./dist/lib/agent-participation.d.ts",
      "import": "./dist/lib/agent-participation.js"
    },
    "./runtime-metrics": {
      "types": "./dist/runtime-metrics.d.ts",
      "import": "./dist/runtime-metrics.js"
    },
    "./sync-runtime": {
      "types": "./dist/sync-runtime.d.ts",
      "import": "./dist/sync-runtime.js"
    },
    "./room-unread": {
      "types": "./dist/lib/room-unread.d.ts",
      "import": "./dist/lib/room-unread.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@shennian/wire": "workspace:*",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.9.3"
  }
}
