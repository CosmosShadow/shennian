  kind      String   @db.VarChar(16)
  updatedAt DateTime @updatedAt
  work      InteractiveWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, workId, kind])
  @@index([userId, kind, updatedAt])
}

model InteractiveAsset {
  id          String   @id @db.VarChar(64)
  workId      String?  @db.VarChar(64)
  ownerId     String
  jobId       String?  @db.VarChar(64)
  objectKey   String   @db.VarChar(512)
  contentType String   @db.VarChar(100)
  size        Int
  readToken   String   @db.VarChar(64)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  work        InteractiveWork? @relation(fields: [workId], references: [id], onDelete: SetNull)
  owner       User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([ownerId, createdAt])
  @@index([jobId])
}

// @arch docs/features/personal-modules.md
// Module payloads are versioned independently of Agent sessions and Room history.
model PersonalModuleRecord {
  id         String   @id @default(cuid())
  userId     String
  kind       String   @db.VarChar(32)
  key        String   @db.VarChar(191)
  sessionKey String?  @db.VarChar(191)
  day        String?  @db.VarChar(10)
  state      String   @default("active") @db.VarChar(32)
  revision   Int      @default(1)
  dueAt      DateTime?
  payload    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, key])
  @@index([userId, kind, day, key])
  @@index([kind, state, dueAt])
  @@index([userId, kind, sessionKey])
}

// Additive durable replica of the daemon's user-visible canonical mutations.
model PersonalSessionCloudMutation {
  sessionId            String
  revision             Int
  dataEpoch            Int
  daemonInstallationId String @db.VarChar(191)
  payload              Json
  session              NianSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, revision])
}
