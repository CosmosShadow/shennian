// @arch docs/features/published-agent-direct-conversations.md#7-2026-09-25-代码调查与实现裁决
// One stable logical publication per Agent. Rotating publicId and generation
// invalidates every older URL without deleting existing visitor history.
model AgentPublication {
  id              String                    @id @default(cuid())
  agentIdentityId String                    @unique
  ownerUserId     String
  publicId        String                    @unique @db.VarChar(64)
  generation      Int                       @default(1)
  status          String                    @default("draft") @db.VarChar(32)
  plazaListed     Boolean                   @default(false)
  allowNewContacts Boolean                  @default(true)
  requireContactApproval Boolean            @default(false)
  allowAnonymousVisitors Boolean            @default(false)
  displayName     String                    @db.VarChar(191)
  description     String                    @default("") @db.VarChar(1000)
  suggestedQuestions Json?
  dailyMessageLimit Int                     @default(100)
  quotaDay        String                    @default("") @db.VarChar(10)
  quotaUsed       Int                       @default(0)
  policyVersion   Int                       @default(1)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  revokedAt       DateTime?
  agentIdentity   AgentIdentity             @relation(fields: [agentIdentityId], references: [id], onDelete: Restrict)
  ownerUser       User                      @relation("AgentPublicationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  conversations   AgentDirectConversation[]
  directAttachments AgentDirectAttachment[]
  browserSessions AgentPublicationBrowserSession[]
  contactRequests AgentContactRequest[]

  @@index([ownerUserId, status, updatedAt])
}

// A request never grants contact or conversation access until the owner approves it.
model AgentContactRequest {
  id              String           @id @default(cuid())
  publicationId   String
  agentIdentityId String
  ownerUserId     String
  requesterUserId String
  status          String           @default("pending") @db.VarChar(32)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  publication     AgentPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  agentIdentity   AgentIdentity    @relation(fields: [agentIdentityId], references: [id], onDelete: Cascade)
  ownerUser       User             @relation("AgentContactOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  requesterUser   User             @relation("AgentContactRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)

  @@unique([agentIdentityId, requesterUserId])
  @@index([ownerUserId, status, createdAt])
}

// A browser proof grants access only to one publication and one verified user.
// It never participates in account, Room, or machine authentication.
model AgentPublicationBrowserSession {
  id            String           @id @default(cuid())
  tokenHash     String           @unique @db.VarChar(64)
  publicationId String
  issuedPublicId String?          @db.VarChar(32)
