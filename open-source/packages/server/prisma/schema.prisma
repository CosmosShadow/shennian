  accessKind    String           @default("account") @db.VarChar(16)
  status        String           @default("active") @db.VarChar(32)
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  lastSeenAt    DateTime         @default(now())
  publication   AgentPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([publicationId, userId, status, expiresAt], map: "AgentPubBrowser_pub_user_status_exp_idx")
  @@index([userId, status, expiresAt], map: "AgentPubBrowser_user_status_exp_idx")
}

// A visitor has exactly one logical conversation with an Agent, even across
// publication generations and internal native Session replacements.
model AgentDirectConversation {
  id              String               @id @default(cuid())
  publicationId   String
  agentIdentityId String
  ownerUserId     String
  visitorUserId   String
  roomId          String?              @unique
  canonicalState  String               @default("legacy") @db.VarChar(16)
  canonicalCopiedSequence BigInt       @default(0)
  status          String               @default("active") @db.VarChar(32)
  nextSequence    BigInt               @default(0)
  lastActivityAt  DateTime             @default(now())
  ownerLastViewedAt DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  publication     AgentPublication     @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  agentIdentity   AgentIdentity        @relation(fields: [agentIdentityId], references: [id], onDelete: Restrict)
  ownerUser       User                 @relation("AgentDirectConversationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  visitorUser     User                 @relation("AgentDirectConversationVisitor", fields: [visitorUserId], references: [id], onDelete: Restrict)
  room            Room?                @relation("LegacyDirectConversationRoom", fields: [roomId], references: [id], onDelete: Restrict)
  messages        AgentDirectMessage[]
  binding         AgentDirectBinding?

  @@unique([agentIdentityId, visitorUserId])
  @@index([ownerUserId, agentIdentityId, lastActivityAt, id])
  @@index([visitorUserId, lastActivityAt, id])
  @@index([publicationId, status, lastActivityAt])
}

model AgentDirectMessage {
  id                 String                  @id @default(cuid())
  conversationId     String
  sequence           BigInt
  authorRole         String                  @db.VarChar(16)
  clientMessageId    String                  @db.VarChar(191)
  publicationGeneration Int                   @default(1)
  policyVersion      Int                     @default(1)
  agentConfigurationVersion Int                @default(1)
  text               String?                 @db.MediumText
  roomMessageId      String?                 @unique
  status             String                  @default("sent") @db.VarChar(32)
  failureCode        String?                 @db.VarChar(32)
  attempts           Int                     @default(0)
  claimTokenHash     String?                 @db.VarChar(64)
  leaseExpiresAt     DateTime?
  createdAt          DateTime                @default(now())
  conversation       AgentDirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  roomMessage        RoomMessage?            @relation("LegacyDirectMessageRoom", fields: [roomMessageId], references: [id], onDelete: Restrict)
  attachments        AgentDirectAttachment[]

  @@unique([conversationId, sequence])
  @@unique([conversationId, authorRole, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([status, leaseExpiresAt, createdAt])
}

// Staged by one public-link visitor, then bound atomically to their sent turn.
model AgentDirectAttachment {
  id             String             @id @default(cuid())
  publicationId  String
  visitorUserId  String
  uploadIntentId String             @unique @db.VarChar(191)
  messageId      String?
  status         String             @default("pending") @db.VarChar(16)
  objectKey      String             @unique @db.VarChar(512)
  name           String             @db.VarChar(255)
  mimeType       String             @db.VarChar(191)
  mediaKind      String             @db.VarChar(16)
  byteSize       BigInt
  sha256         String             @db.VarChar(64)
  createdAt      DateTime           @default(now())
  readyAt        DateTime?
  expiresAt      DateTime?
  publication    AgentPublication   @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  visitor        User               @relation(fields: [visitorUserId], references: [id], onDelete: Cascade)
  message        AgentDirectMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([publicationId, visitorUserId, status, createdAt], map: "AgentDirectAttachment_lookup_idx")
  @@index([messageId])
  @@index([status, expiresAt])
}

// Native Session is replaceable; the logical conversation and messages are not.
model AgentDirectBinding {
  id                   String                  @id @default(cuid())
  conversationId       String                  @unique
  nianSessionId        String?                 @unique
  machineId            String
  runtimeAdapter       String                  @db.VarChar(64)
  bindingEpoch         Int                     @default(1)
  appliedPolicyVersion Int                     @default(1)
  lastDeliveredSequence BigInt                 @default(0)
  status               String                  @default("pending") @db.VarChar(32)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  conversation         AgentDirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([machineId, status])
}

