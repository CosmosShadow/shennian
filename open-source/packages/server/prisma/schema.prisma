datasource db {
  provider = "mysql"
}

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

model InstanceAccount {
  username String @id @db.VarChar(64)
  userId String @unique
  passwordHash String @db.VarChar(256)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  instanceAccount InstanceAccount?
  personalModuleRecords PersonalModuleRecord[]
  id                           String                        @id @default(cuid())
  phone                        String?                       @unique
  email                        String?
  googleSub                    String?                       @unique
  appleSub                     String?                       @unique
  name                         String                        @default("")
  description                  String                        @default("") @db.VarChar(1000)
  nameSetupRequired            Boolean                       @default(false)
  avatarVersion                String?                       @db.VarChar(43)
  avatarOriginalObjectKey      String?                       @db.VarChar(512)
  avatarSmallObjectKey         String?                       @db.VarChar(512)
  avatarMediumObjectKey        String?                       @db.VarChar(512)
  avatarUpdatedAt              DateTime?
  voiceChiefVoice              String?                       @db.VarChar(64)
  accountTier                  String                        @default("personal")
  entitlementFlags             Json?
  createdAt                    DateTime                      @default(now())
  machines                     Machine[]
  grantsGiven                  MachineGrant[]                @relation("Granter")
  grantsRecv                   MachineGrant[]                @relation("Grantee")
  organizationsOwned           Organization[]                @relation("OrganizationOwner")
  organizationMembers          OrganizationMember[]
  organizationInvitesCreated   OrganizationInvite[]          @relation("OrganizationInviteCreator")
  devices                      Device[]
  pushRegistrations            DevicePushRegistration[]
  sessionStates                SessionUserState[]
  voiceChiefMemory             VoiceChiefMemory?
  shennianMessages             ShennianMessage[]
  shennianRuns                 ShennianRun[]
  weComAccounts                WeComAccount[]
  feishuAccounts               FeishuAccount[]
  externalBindings             ExternalConversationBinding[]
  externalInboundMessages      ExternalInboundMessage[]
  wechatChannelRuntimes        WechatChannelRuntime[]
  wechatChannelBindings        WechatChannelBinding[]
  wechatChannelRunEvents       WechatChannelRunEvent[]
  billingSubscriptions         BillingSubscription[]
  billingOrders                BillingOrder[]
  billingAuditLogs             BillingAuditLog[]
  inviteCodesIssued            InviteCode[]                  @relation("InviteCodeIssuer")
  inviteRewardsInvited         InviteReward[]                @relation("InviteRewardInvitee")
  inviteRewardsReceived        InviteReward[]                @relation("InviteRewardRecipient")
  promotionSubmissions         PromotionSubmission[]
  adapterSubmissions           AdapterSubmission[]
  creditBuckets                CreditBucket[]
  creditLedger                 CreditLedger[]
  voiceTaskCompletionNotifies  VoiceTaskCompletionNotify[]
  voiceIncomingCallIntents     VoiceIncomingCallIntent[]
  sessionTerminalNotifications SessionTerminalNotification[]
  agentIdentities              AgentIdentity[]               @relation("AgentIdentityOwnerUser")
  roomsCreated                 Room[]                        @relation("RoomCreatedBy")
  roomsOwned                   Room[]                        @relation("RoomOwner")
  roomMemberships              RoomMembership[]              @relation("RoomMembershipUser")
  roomMembershipsOwned         RoomMembership[]              @relation("RoomMembershipOwner")
  roomInvitesCreated           RoomInvite[]                  @relation("RoomInviteCreator")
  roomInvitesReceived          RoomInvite[]                  @relation("RoomInviteTarget")
  roomJoinRequests             RoomJoinRequest[]             @relation("RoomJoinApplicant")
  roomJoinRequestsReviewed     RoomJoinRequest[]             @relation("RoomJoinReviewer")
  roomBindings                 RoomBinding[]
  roomBrowserIdentities        RoomBrowserIdentity[]
  roomBrowserSessions          RoomBrowserSession[]
  loginIntentsApproved         LoginIntent[]                 @relation("LoginIntentApprovedUser")
  agentPublicationsOwned       AgentPublication[]           @relation("AgentPublicationOwner")
  agentDirectConversationsOwned AgentDirectConversation[]    @relation("AgentDirectConversationOwner")
  agentDirectConversationsVisited AgentDirectConversation[]  @relation("AgentDirectConversationVisitor")
  agentPublicationBrowserSessions AgentPublicationBrowserSession[]
  agentDirectAttachments       AgentDirectAttachment[]
  contactsSaved                UserContact[]                 @relation("UserContactOwner")
  contactsSavedByOthers        UserContact[]                 @relation("UserContactTargetUser")
  agentContactRequestsMade     AgentContactRequest[]        @relation("AgentContactRequester")
  agentContactRequestsOwned    AgentContactRequest[]        @relation("AgentContactOwner")
  interactiveWorks      InteractiveWork[]
  interactiveJobs       InteractiveJob[]
  interactiveActivities InteractiveActivity[]
  interactiveAssets     InteractiveAsset[]
}

/** A private, unilateral saved contact; saving never grants access to its target. */
model UserContact {
  id                    String         @id @default(cuid())
  ownerUserId           String
  targetUserId          String?
  targetAgentIdentityId String?
  createdAt             DateTime       @default(now())
  ownerUser             User           @relation("UserContactOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  targetUser            User?          @relation("UserContactTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetAgentIdentity   AgentIdentity? @relation(fields: [targetAgentIdentityId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, targetUserId])
  @@unique([ownerUserId, targetAgentIdentityId])
  @@index([targetUserId])
  @@index([targetAgentIdentityId])
}

/** Release-controlled write fence; readers never infer cutover from shadow rows. */
model ConversationWriteControl {
  name      String   @id @db.VarChar(32)
  mode      String   @default("legacy") @db.VarChar(16)
  everCanonical Boolean @default(false)
  updatedAt DateTime @updatedAt
}

model WeComAccount {
  id             String                        @id @default(cuid())
  userId         String
  qiweGuid       String?                       @unique
  qiweClientId   String?
  nickname       String                        @default("")
  status         String                        @default("pending")
  loginAreaCode  String?
  loginAreaName  String?
  loginQrCodeUrl String?                       @db.Text
  loginExpiresAt DateTime?
  rawProfile     Json?
  lastSyncedAt   DateTime?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  user           User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations  WeComConversation[]
  bindings       ExternalConversationBinding[]

  @@unique([userId])
  @@index([status])
}

model WeComConversation {
  id                 String                        @id @default(cuid())
  accountId          String
  qiweConversationId String
  type               String                        @default("group")
  name               String
  raw                Json?
  lastMessageAt      DateTime?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  account            WeComAccount                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bindings           ExternalConversationBinding[]

  @@unique([accountId, qiweConversationId])
  @@index([accountId, updatedAt])
}

model FeishuAccount {
  id                String                        @id @default(cuid())
  userId            String
  appId             String                        @unique
  appSecretCipher   String                        @db.Text
  verificationToken String?                       @db.Text
  encryptKeyCipher  String?                       @db.Text
  tenantKey         String?
  botOpenId         String?
  displayName       String                        @default("飞书机器人")
  status            String                        @default("configured")
  rawProfile        Json?
  lastSyncedAt      DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  user              User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations     FeishuConversation[]
  bindings          ExternalConversationBinding[]

  @@unique([userId])
  @@index([status])
}

model FeishuConversation {
  id           String                        @id @default(cuid())
  accountId    String
  feishuChatId String
  type         String                        @default("group")
  name         String
  raw          Json?
  lastEventAt  DateTime?
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt
  account      FeishuAccount                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bindings     ExternalConversationBinding[]

  @@unique([accountId, feishuChatId])
  @@index([accountId, updatedAt])
}

model ExternalConversationBinding {
  id                   String                   @id @default(cuid())
  userId               String
  sessionId            String
  machineId            String
  provider             String                   @default("wecom")
  accountId            String?
  conversationId       String?
  feishuAccountId      String?
  feishuConversationId String?
  listenMode           String                   @default("mention_only")
  allowSend            Boolean                  @default(true)
  systemPrompt         String?                  @db.Text
  channelToken         String                   @unique @db.VarChar(512)
  status               String                   @default("active")
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session              NianSession              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  account              WeComAccount?            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversation         WeComConversation?       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feishuAccount        FeishuAccount?           @relation(fields: [feishuAccountId], references: [id], onDelete: Cascade)
  feishuConversation   FeishuConversation?      @relation(fields: [feishuConversationId], references: [id], onDelete: Cascade)
  inboundMessages      ExternalInboundMessage[]

  @@unique([sessionId, provider])
  @@index([userId, status])
  @@index([machineId])
}

model ExternalInboundMessage {
  id                     String                      @id @default(cuid())
  userId                 String
  bindingId              String
  sessionId              String
  provider               String
  externalAccountId      String
  externalConversationId String
  externalMessageId      String
  conversationName       String                      @default("")
  conversationType       String                      @default("group")
  senderId               String                      @default("")
  senderName             String                      @default("")
  text                   String                      @db.Text
  attachments            Json?
  isMention              Boolean                     @default(false)
  rawRef                 String?
  receivedAt             DateTime
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  user                   User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  binding                ExternalConversationBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@unique([provider, bindingId, externalMessageId])
  @@index([provider, bindingId, receivedAt])
  @@index([userId, provider, receivedAt])
}

model WechatChannelRuntime {
  id                        String                  @id @default(cuid())
  userId                    String
  machineId                 String
  status                    String                  @default("active")
  pollIntervalSeconds       Int                     @default(300)
  foregroundPolicy          String                  @default("work")
  helperVersion             String?                 @db.VarChar(64)
  clientRuntimeVersion      String?                 @db.VarChar(64)
  schemaVersion             Int                     @default(1)
  lastLeftListFingerprint   String?                 @db.VarChar(191)
  wechatAppDetected         Boolean?
  accessibilityPermission   String?                 @db.VarChar(32)
  screenRecordingPermission String?                 @db.VarChar(32)
  inputMonitoringPermission String?                 @db.VarChar(32)
  automationPermission      String?                 @db.VarChar(32)
  helperReady               Boolean?
  lastPreflightAt           DateTime?
  lastSeenAt                DateTime?
  lastScanAt                DateTime?
  nextScanAt                DateTime?
  lastRunStatus             String?                 @db.VarChar(64)
  lastErrorCode             String?                 @db.VarChar(128)
  lastErrorSummary          String?                 @db.Text
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  user                      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  machine                   Machine                 @relation(fields: [machineId], references: [id], onDelete: Cascade)
  bindings                  WechatChannelBinding[]
  runEvents                 WechatChannelRunEvent[]

  @@index([userId, machineId])
  @@index([status, nextScanAt])
}

model WechatChannelBinding {
  id                          String                       @id @default(cuid())
  runtimeId                   String
  userId                      String
  machineId                   String
  sessionId                   String
  conversationDisplayName     String                       @db.VarChar(191)
  enabled                     Boolean                      @default(true)
  allowReply                  Boolean                      @default(true)
  downloadMedia               Boolean                      @default(true)
  lastConversationFingerprint String?                      @db.VarChar(191)
  lastConversationAnchor      Json?
  lastStructuredAt            DateTime?
  ledgerRevision              Int                          @default(0)
  lastInboundRevision         Int                          @default(0)
  lastOutboundRevision        Int                          @default(0)
  lastErrorCode               String?                      @db.VarChar(128)
  lastErrorSummary            String?                      @db.Text
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  runtime                     WechatChannelRuntime         @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  machine                     Machine                      @relation(fields: [machineId], references: [id], onDelete: Cascade)
  session                     NianSession                  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  recentMessages              WechatChannelRecentMessage[]
  visualVectors               WechatChannelVisualVector[]
  runEvents                   WechatChannelRunEvent[]
  outboundReplies             WechatChannelOutboundReply[]

  @@index([runtimeId, enabled])
  @@index([sessionId])
  @@index([userId, machineId])
}

model WechatChannelRecentMessage {
  id               String                      @id @default(cuid())
  bindingId        String
  runtimeId        String
  sessionId        String
  windowIndex      Int
  stableMessageKey String                      @db.VarChar(191)
  stableKeyVersion Int                         @default(1)
  senderRole       String                      @db.VarChar(32)
  senderName       String?                     @db.VarChar(191)
  kind             String                      @db.VarChar(64)
  normalizedText   String?                     @db.VarChar(1000)
  anchorText       String?                     @db.VarChar(1000)
  anchorMetadata   Json?
  neighborContext  Json?
  textExcerpt      String?                     @db.VarChar(500)
  bbox             Json?
  mediaMetadata    Json?
  isBaseline       Boolean                     @default(false)
  deliveryStatus   String                      @default("seen") @db.VarChar(64)
  hasVisualVector  Boolean                     @default(false)
  observedAt       DateTime
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  binding          WechatChannelBinding        @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  session          NianSession                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  visualVectors    WechatChannelVisualVector[]

  @@index([bindingId, windowIndex])
  @@index([bindingId, stableMessageKey])
  @@index([bindingId, observedAt])
}

model WechatChannelVisualVector {
  id         String                     @id @default(cuid())
  bindingId  String
  messageId  String
  blockId    String                     @db.VarChar(191)
  blockKind  String                     @db.VarChar(64)
  bbox       Json?
  model      String                     @db.VarChar(128)
  dims       Int
  vectorBlob Bytes                      @db.Blob
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt
  binding    WechatChannelBinding       @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  message    WechatChannelRecentMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([bindingId, messageId])
  @@index([bindingId, blockKind])
}

model WechatChannelRunEvent {
  id           String                @id @default(cuid())
  runtimeId    String
  bindingId    String?
  sessionId    String?
  userId       String
  machineId    String
  eventType    String                @db.VarChar(64)
  status       String                @db.VarChar(64)
  reasonCode   String?               @db.VarChar(128)
  usage        Json?
  latencyMs    Int?
  modelVersion String?               @db.VarChar(128)
  traceId      String?               @db.VarChar(128)
  createdAt    DateTime              @default(now())
  runtime      WechatChannelRuntime  @relation(fields: [runtimeId], references: [id], onDelete: Cascade)
  binding      WechatChannelBinding? @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([runtimeId, createdAt])
  @@index([bindingId, createdAt])
}

model WechatChannelIdempotency {
  id             String   @id @default(cuid())
  scope          String   @db.VarChar(64)
  idempotencyKey String   @db.VarChar(191)
  bindingId      String?
  sessionId      String?
  status         String   @default("pending") @db.VarChar(64)
  resultRef      String?  @db.VarChar(191)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([scope, idempotencyKey])
  @@index([expiresAt])
}

model WechatChannelOutboundReply {
  id                String               @id @default(cuid())
  replyId           String               @db.VarChar(191)
  idempotencyKey    String               @unique @db.VarChar(191)
  bindingId         String
  runtimeId         String
  sessionId         String
  replyBaseRevision Int
  sendStatus        String               @db.VarChar(64)
  sentAt            DateTime?
  confirmedAt       DateTime?
  failureCode       String?              @db.VarChar(128)
  lastErrorSummary  String?              @db.Text
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  binding           WechatChannelBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@index([bindingId, createdAt])
  @@index([replyId])
}

model BillingSubscription {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  productId      String
  kind           String
  status         String        @default("active")
  seatCount      Int           @default(0)
  startsAt       DateTime      @default(now())
  expiresAt      DateTime?
  sourceOrderId  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, status, expiresAt])
  @@index([productId, status])
  @@index([organizationId, status, expiresAt])
}

model BillingOrder {
  id                    String        @id @default(cuid())
  userId                String
  organizationId        String?
  productId             String
  productKind           String
  seatCount             Int           @default(0)
  amountCents           Int
  currency              String        @default("CNY")
  periodMonths          Int           @default(1)
  provider              String        @default("wechat")
  providerOrderNo       String        @unique
  providerTransactionId String?
  status                String        @default("pending")
  codeUrl               String?       @db.Text
  raw                   Json?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization          Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([productId, status])
  @@index([organizationId, status, createdAt])
}

model BillingAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   @db.VarChar(64)
  refType   String?  @db.VarChar(64)
  refId     String?  @db.VarChar(191)
  actor     String?  @db.VarChar(191)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([refType, refId])
}

model InviteCode {
  id             String         @id @default(cuid())
  code           String         @unique @db.VarChar(64)
  issuerId       String
  status         String         @default("active") @db.VarChar(32)
  maxRedemptions Int            @default(1)
  usedCount      Int            @default(0)
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  issuer         User           @relation("InviteCodeIssuer", fields: [issuerId], references: [id], onDelete: Cascade)
  rewards        InviteReward[]

  @@index([issuerId, status])
  @@index([status, expiresAt])
}

model InviteReward {
  id           String      @id @default(cuid())
  inviteCodeId String?
  inviterId    String?
  inviteeId    String?
  recipientId  String
  event        String      @db.VarChar(64)
  status       String      @default("awarded") @db.VarChar(32)
  proDays      Int         @default(0)
  credits      Int         @default(0)
  metadata     Json?
  awardedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  inviteCode   InviteCode? @relation(fields: [inviteCodeId], references: [id], onDelete: SetNull)
  invitee      User?       @relation("InviteRewardInvitee", fields: [inviteeId], references: [id], onDelete: SetNull)
  recipient    User        @relation("InviteRewardRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, event, status])
  @@index([inviteeId, event])
  @@index([inviterId, event])
  @@index([inviteCodeId])
}

model PromotionSubmission {
  id               String    @id @default(cuid())
  userId           String
  channel          String    @db.VarChar(64)
  url              String?   @db.Text
  description      String?   @db.Text
  status           String    @default("pending") @db.VarChar(32)
  suggestedProDays Int       @default(0)
  suggestedCredits Int       @default(0)
  awardedProDays   Int       @default(0)
  awardedCredits   Int       @default(0)
  evidence         Json?
  reviewedBy       String?   @db.VarChar(191)
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}

model CreditBucket {
  id              String         @id @default(cuid())
  userId          String
  source          String         @db.VarChar(64)
  amountGranted   Int
  amountRemaining Int
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger          CreditLedger[]

  @@index([userId, expiresAt])
  @@index([source])
}

model CreditLedger {
  id        String        @id @default(cuid())
  userId    String
  bucketId  String?
  delta     Int
  reason    String        @db.VarChar(64)
  refType   String?       @db.VarChar(64)
  refId     String?       @db.VarChar(191)
  metadata  Json?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucket    CreditBucket? @relation(fields: [bucketId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([bucketId])
  @@index([reason, refId])
}

model QrSession {
  id                   String   @id @default(cuid())
  token                String   @unique
  type                 String
  status               String   @default("pending")
  userId               String?
  machineId            String?
  deviceId             String?
  deviceInstallationId String?  @db.VarChar(191)
  targetPlatform       String?  @db.VarChar(32)
  targetDeviceName     String?  @db.VarChar(120)
  expiresAt            DateTime
  createdAt            DateTime @default(now())
}

model LoginIntent {
  id                   String    @id @default(cuid())
  deviceSecretHash     String    @unique @db.Char(64)
  daemonInstallationId String?   @db.VarChar(191)
  machineName          String    @db.VarChar(120)
  machineOs            String    @db.VarChar(64)
  agentList            Json      @default("[]")
  actionType           String    @db.VarChar(64)
  actionSummary        String    @db.VarChar(255)
  actionPayloadHash    String    @db.Char(64)
  returnTo             String    @db.VarChar(512)
  status               String    @default("waiting_user") @db.VarChar(32)
  approvedUserId       String?
  machineId            String?   @unique
  expiresAt            DateTime
  approvedAt           DateTime?
  claimedAt            DateTime?
  deniedAt             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  approvedUser         User?     @relation("LoginIntentApprovedUser", fields: [approvedUserId], references: [id], onDelete: SetNull)
  machine              Machine?  @relation(fields: [machineId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([approvedUserId, createdAt])
}

model Machine {
  id                         String                 @id @default(cuid())
  userId                     String?
  name                       String
  os                         String
  agentList                  Json                   @default("[]")
  agents                     Json?
  pairToken                  String?                @unique
  machineToken               String?                @unique @db.VarChar(512)
  paired                     Boolean                @default(false)
  lastSeen                   DateTime               @default(now())
  online                     Boolean                @default(false)
  cliVersion                 String?
  sessionSyncProtocolVersion Int?
  sessionSyncDataEpoch       Int?
  sessionSyncCapabilities    Json?
  daemonInstallationId       String?                @db.VarChar(191)
  deletionRevision           Int                    @default(0)
  autoUpgrade                String?                @default("none")
  remoteAccessDisabledAt     DateTime?
  user                       User?                  @relation(fields: [userId], references: [id])
  sessions                   NianSession[]
  projects                   SessionProject[]
  wechatChannelRuntimes      WechatChannelRuntime[]
  wechatChannelBindings      WechatChannelBinding[]
  grants                     MachineGrant[]
  roomBindings               RoomBinding[]
  agentIdentities            AgentIdentity[]
  loginIntent                LoginIntent?
  adapterSubmissions         AdapterSubmission[]

  @@unique([daemonInstallationId])
  @@index([userId, daemonInstallationId])
}

model SessionProject {
